{
  "name": "devis-facture-tn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run src/lib/money --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "test:concurrency": "node scripts/test-concurrency.mjs",
    "test:e2e-auth": "node scripts/test-e2e-auth.mjs",
    "test:e2e-settings": "node scripts/test-e2e-settings.mjs",
    "test:e2e-documents": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-e2e-documents.mjs",
    "test:e2e-items": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-e2e-items.mjs",
    "test:e2e-payments": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-e2e-payments.mjs",
    "money:vectors": "node scripts/generate-money-vectors.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "i18next": "^26.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.16",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
